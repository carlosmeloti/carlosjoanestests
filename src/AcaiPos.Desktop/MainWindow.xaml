                            </Grid>
                            <TextBlock Text="Confirme o saldo ou informe um valor menor." Style="{StaticResource MutedText}" Margin="0,8,0,16" TextWrapping="Wrap"/>
                            <TextBlock Text="Valor" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding PaymentEntryAmountText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FieldTextBox}"/>
                            <TextBlock Text="{Binding PaymentEntryMessage}" Foreground="{StaticResource BrushWarning}" FontWeight="SemiBold"
                                       Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding PaymentEntryMessageVisibility}"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0">
                                <Run Text="Saldo restante: "/><Run Text="{Binding PaymentRemainingLabel, Mode=OneWay}"/>
                            </TextBlock>
                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="Voltar" Style="{StaticResource GhostTouchButton}" Height="56"
                                        Command="{Binding BackToPaymentMethodsCommand}"/>
                                <Button Grid.Column="1" Content="Aceitar" Style="{StaticResource PrimaryTouchButton}" Height="56"
                                        Command="{Binding AcceptPaymentAmountCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- Open cash panel -->
            <Border Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="30" Background="#CC0F1419" Visibility="{Binding ShowCashOpenPanel, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource BrushBgPanel}" CornerRadius="24" Padding="28" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Abrir caixa" Style="{StaticResource TitleText}" FontSize="28"/>
                        <TextBlock Text="Informe o fundo de troco inicial" Style="{StaticResource MutedText}" Margin="0,8,0,20"/>
                        <TextBox Text="{Binding OpeningAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Style="{StaticResource FieldTextBox}"/>
                        <Button Content="ABRIR CAIXA" Style="{StaticResource PrimaryTouchButton}" Height="64" Margin="0,20,0,0" Command="{Binding ConfirmOpenCashCommand}"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Close cash panel -->
            <Border Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="30" Background="#CC0F1419" Visibility="{Binding ShowCashClosePanel, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource BrushBgPanel}" CornerRadius="24" Padding="28" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Fechar caixa" Style="{StaticResource TitleText}" FontSize="28"/>
                        <TextBlock Text="{Binding CashSummaryText}" Style="{StaticResource MutedText}" Margin="0,8,0,8" TextWrapping="Wrap"/>
                        <TextBlock Text="Informe o valor contado em dinheiro" Style="{StaticResource MutedText}" Margin="0,8,0,20"/>
                        <TextBox Text="{Binding CountedAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Style="{StaticResource FieldTextBox}"/>
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Cancelar" Style="{StaticResource GhostTouchButton}" Height="56" Command="{Binding CancelCloseCashCommand}"/>
                            <Button Grid.Column="1" Content="Confirmar" Style="{StaticResource PrimaryTouchButton}" Height="56" Command="{Binding ConfirmCloseCashCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Sangria / Suprimento -->
            <Border Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="30" Background="#CC0F1419" Visibility="{Binding ShowCashMovementPanel, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource BrushBgPanel}" CornerRadius="24" Padding="28" Width="640" MaxHeight="720"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding CashMovementTitle}" Style="{StaticResource TitleText}" FontSize="28"/>
                            <TextBlock Text="{Binding CashSummaryText}" Style="{StaticResource MutedText}" Margin="0,8,0,16" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="Valor" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding CashMovementAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Style="{StaticResource FieldTextBox}"/>
                            <TextBlock Text="Motivo" Style="{StaticResource MutedText}" Margin="0,14,0,8"/>
                            <TextBox Text="{Binding CashMovementReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"
                                     Height="72" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                        </StackPanel>

                        <Border Grid.Row="2" Background="{StaticResource BrushBgElevated}" CornerRadius="16" Padding="12" Margin="0,18,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Movimentações deste caixa" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="220">
                                    <ItemsControl ItemsSource="{Binding CashMovements}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BrushStroke}" BorderThickness="0,0,0,1" Padding="0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold">
                                                                <Run Text="{Binding TypeLabel}"/>
                                                                <Run Text=" · "/>
                                                                <Run Text="{Binding OperatorName}"/>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                                            <TextBlock Style="{StaticResource MutedText}" FontSize="12"
                                                                       Text="{Binding OccurredAt, StringFormat={}{0:dd/MM HH:mm}}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat=C}"
                                                                   FontFamily="{StaticResource FontDisplay}" FontSize="18"
                                                                   Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Cancelar" Style="{StaticResource GhostTouchButton}" Height="56" Command="{Binding CancelCashMovementCommand}"/>
                            <Button Grid.Column="1" Content="Confirmar" Style="{StaticResource PrimaryTouchButton}" Height="56" Command="{Binding ConfirmCashMovementCommand}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- Ticket preview -->
            <Border Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="30" Background="#CC0F1419" Visibility="{Binding ShowTicketPanel, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource BrushBgPanel}" CornerRadius="24" Padding="24" Width="520" MaxHeight="780"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding TicketPanelTitle}" Style="{StaticResource TitleText}" FontSize="26" Margin="0,0,0,12"/>

                        <Border Grid.Row="1" Background="#FF11161C" CornerRadius="14" Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                                <TextBox Text="{Binding TicketPreviewText}"
                                         IsReadOnly="True"
                                         TextWrapping="NoWrap"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{StaticResource BrushTextPrimary}"
                                         FontFamily="Consolas"
                                         FontSize="13"
                                         AcceptsReturn="True"/>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Nova venda" Style="{StaticResource GhostTouchButton}" Height="56" Command="{Binding CloseTicketCommand}"/>
                            <Button Grid.Column="1" Content="Imprimir" Style="{StaticResource PrimaryTouchButton}" Height="56" Command="{Binding PrintTicketCommand}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- Reprint list -->
            <Border Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="30" Background="#CC0F1419" Visibility="{Binding ShowReprintPanel, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource BrushBgPanel}" CornerRadius="24" Padding="24" Width="720" MaxHeight="780"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Tickets de hoje" Style="{StaticResource TitleText}" FontSize="26" DockPanel.Dock="Left"/>
                            <Button Content="Fechar" Style="{StaticResource GhostTouchButton}" Padding="16,10" HorizontalAlignment="Right"
                                    Command="{Binding CloseReprintCommand}"/>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TodayTickets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushBgElevated}" CornerRadius="14" Padding="14" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="16"
                                                               Text="{Binding TicketNumber}"/>
                                                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0">
                                                        <Run Text="{Binding SoldAt, StringFormat={}{0:dd/MM HH:mm}}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding OperatorName}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding Status}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Total, StringFormat=C}" Foreground="{StaticResource BrushAccent}"
                                                               FontFamily="{StaticResource FontDisplay}" FontSize="20" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Ver" Style="{StaticResource GhostTouchButton}" Padding="14,10" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.ViewTicketCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Reimprimir" Style="{StaticResource PrimaryTouchButton}" Padding="14,10"
                                                            Command="{Binding DataContext.ReprintSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
