<Window x:Class="AcaiPos.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AcaiPos.Desktop.ViewModels"
        xmlns:behaviors="clr-namespace:AcaiPos.Desktop.Behaviors"
        Title="AcaiPos"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgDeep}"
        FontFamily="{StaticResource FontBody}"
        MinWidth="1280"
        MinHeight="800">

    <Grid>
        <!-- LOGIN -->
        <Grid Visibility="{Binding LoginVisibility}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF0F1419" Offset="0"/>
                    <GradientStop Color="#FF1A242E" Offset="0.55"/>
                    <GradientStop Color="#FF2A1A16" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Grid MaxWidth="980" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,40,0">
                    <TextBlock Text="AÇAI PDV" FontFamily="{StaticResource FontDisplay}" FontSize="64" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="PDV touch-first para operação rápida de caixa"
                               Style="{StaticResource MutedText}" FontSize="18" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <Border Background="{StaticResource BrushAccentSoft}" CornerRadius="16" Padding="18" Margin="0,36,0,0">
                        <StackPanel>
                            <TextBlock Text="Acesso inicial" Foreground="{StaticResource BrushAccent}" FontWeight="SemiBold"/>
                            <TextBlock Text="usuário: operador · PIN: 1234" Foreground="{StaticResource BrushTextPrimary}" Margin="0,8,0,0" FontSize="16"/>
                            <TextBlock Text="também: admin / gerente" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Background="{StaticResource BrushBgPanel}" CornerRadius="24" Padding="28">
                    <StackPanel>
                        <TextBlock Text="Entrar" Style="{StaticResource TitleText}" FontSize="28"/>
                        <TextBlock Text="Identifique o operador" Style="{StaticResource MutedText}" Margin="0,6,0,20"/>

                        <TextBlock Text="Usuário" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>

                        <TextBlock Text="PIN" Style="{StaticResource MutedText}" Margin="0,18,0,8"/>
                        <TextBox Text="{Binding Pin, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldTextBox}"
                                 FontFamily="{StaticResource FontDisplay}"
                                 FontSize="28"/>

                        <UniformGrid Columns="3" Margin="0,18,0,0">
                            <Button Style="{StaticResource PinButton}" Content="1" Command="{Binding AppendPinCommand}" CommandParameter="1"/>
                            <Button Style="{StaticResource PinButton}" Content="2" Command="{Binding AppendPinCommand}" CommandParameter="2"/>
                            <Button Style="{StaticResource PinButton}" Content="3" Command="{Binding AppendPinCommand}" CommandParameter="3"/>
                            <Button Style="{StaticResource PinButton}" Content="4" Command="{Binding AppendPinCommand}" CommandParameter="4"/>
                            <Button Style="{StaticResource PinButton}" Content="5" Command="{Binding AppendPinCommand}" CommandParameter="5"/>
                            <Button Style="{StaticResource PinButton}" Content="6" Command="{Binding AppendPinCommand}" CommandParameter="6"/>
                            <Button Style="{StaticResource PinButton}" Content="7" Command="{Binding AppendPinCommand}" CommandParameter="7"/>
                            <Button Style="{StaticResource PinButton}" Content="8" Command="{Binding AppendPinCommand}" CommandParameter="8"/>
                            <Button Style="{StaticResource PinButton}" Content="9" Command="{Binding AppendPinCommand}" CommandParameter="9"/>
                            <Button Style="{StaticResource PinButton}" Content="C" Command="{Binding ClearPinCommand}"/>
                            <Button Style="{StaticResource PinButton}" Content="0" Command="{Binding AppendPinCommand}" CommandParameter="0"/>
                            <Button Style="{StaticResource PinButton}" Content="⌫" Command="{Binding BackspacePinCommand}"/>
                        </UniformGrid>

                        <Button Content="ENTRAR" Style="{StaticResource PrimaryTouchButton}" Height="64" Margin="0,18,0,0"
                                Command="{Binding LoginCommand}"/>

                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,16,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- WORKSPACE -->
        <Grid Visibility="{Binding WorkspaceVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="{Binding NavRailWidth}" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushStroke}" BorderThickness="0,0,1,0" Padding="10,16,10,12">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="FAST GOURMET" FontFamily="{StaticResource FontDisplay}" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" Margin="4,0,44,0" VerticalAlignment="Center"
                                       Visibility="{Binding NavLabelVisibility}"/>
                            <Button Command="{Binding ToggleNavCommand}" ToolTip="{Binding NavToggleToolTip}"
                                    Width="44" Height="44" Padding="0"
                                    HorizontalAlignment="{Binding NavToggleHorizontalAlignment}"
                                    Style="{StaticResource NavRailButton}">
                                <TextBlock Text="{Binding NavToggleGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="OPERAÇÃO" Style="{StaticResource MutedText}" FontSize="12" FontWeight="SemiBold" Margin="8,8,0,4"
                                       Visibility="{Binding NavLabelVisibility}"/>
                            <Button Command="{Binding GoToSaleCommand}" ToolTip="Venda">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE719;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Venda" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding NavLabelVisibility}"/>
                                </StackPanel>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavRailItemButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaleScreen}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushAccentSoft}"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Command="{Binding GoToHistoryCommand}" ToolTip="Histórico">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Histórico" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding NavLabelVisibility}"/>
                                </StackPanel>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavRailItemButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHistoryScreen}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushAccentSoft}"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Command="{Binding GoToCashSessionCommand}" ToolTip="Caixa">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE825;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Caixa" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding NavLabelVisibility}"/>
                                </StackPanel>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavRailItemButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCashSessionScreen}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushAccentSoft}"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Command="{Binding OpenReprintCommand}" ToolTip="Tickets" Style="{StaticResource NavRailItemButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE749;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Tickets" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding NavLabelVisibility}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenSupplyCommand}" ToolTip="Suprimento" Style="{StaticResource NavRailItemButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Suprimento" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding NavLabelVisibility}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenWithdrawalCommand}" ToolTip="Sangria" Style="{StaticResource NavRailItemButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE894;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Sangria" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding NavLabelVisibility}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CloseCashCommand}" ToolTip="Fechar caixa" Style="{StaticResource NavRailItemButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Fechar caixa" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding NavLabelVisibility}"/>
                                </StackPanel>
                            </Button>

                            <StackPanel Margin="0,12,0,0" Visibility="{Binding AdminSectionVisibility}">
                                <TextBlock Text="ADMINISTRAÇÃO" Style="{StaticResource MutedText}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,4"
                                           Visibility="{Binding NavLabelVisibility}"/>
                                <Button Command="{Binding GoToCatalogCommand}" Visibility="{Binding CatalogButtonVisibility}" ToolTip="Cadastros">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7B8;" Style="{StaticResource NavIcon}"/>
                                        <TextBlock Text="Cadastros" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding NavLabelVisibility}"/>
                                    </StackPanel>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavRailItemButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCatalogScreen}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BrushAccentSoft}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding GoToUsersCommand}" Visibility="{Binding UsersButtonVisibility}" ToolTip="Usuários">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE716;" Style="{StaticResource NavIcon}"/>
                                        <TextBlock Text="Usuários" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding NavLabelVisibility}"/>
                                    </StackPanel>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavRailItemButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUsersScreen}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BrushAccentSoft}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushStroke}" BorderThickness="0,0,0,1" Padding="20,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OperatorName}" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="  ·  " Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TerminalLabel}" Foreground="{StaticResource BrushTextMuted}" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Background="{StaticResource BrushBgElevated}" CornerRadius="10" Padding="12,6" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource BrushSuccess}" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="{Binding ClockText}" Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontDisplay}"
                                           FontSize="22" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <Button Command="{Binding ToggleCashMenuCommand}" Margin="0,0,12,0" VerticalAlignment="Center" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CashChip" Background="{StaticResource BrushAccentSoft}" CornerRadius="10" Padding="12,6">
                                                <TextBlock Text="{Binding CashStatusText}" Foreground="{StaticResource BrushAccent}" FontWeight="SemiBold"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CashChip" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="CashChip" Property="Opacity" Value="0.7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Content="Sair" Style="{StaticResource TouchButton}" Padding="14,10" Command="{Binding LogoutCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Panel.ZIndex="20" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,8,16,0" Width="280" Padding="12"
                            Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushStroke}" BorderThickness="1"
                            CornerRadius="16" Visibility="{Binding ShowCashMenu, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Caixa" Style="{StaticResource TitleText}" FontSize="18" Margin="4,0,4,8"/>
                            <Button Content="Abrir caixa" Style="{StaticResource NavRailButton}" Command="{Binding OpenCashCommand}"
                                    Visibility="{Binding IsCashOpen, Converter={StaticResource InverseBoolToVis}}"/>
                            <Button Content="Suprimento" Style="{StaticResource NavRailButton}" Command="{Binding OpenSupplyCommand}"
                                    Visibility="{Binding CashMovementButtonsVisibility}"/>
                            <Button Content="Sangria" Style="{StaticResource NavRailButton}" Command="{Binding OpenWithdrawalCommand}"
                                    Visibility="{Binding CashMovementButtonsVisibility}"/>
                            <Button Content="Fechar caixa" Style="{StaticResource NavRailButton}" Command="{Binding CloseCashCommand}"
                                    Visibility="{Binding CashMovementButtonsVisibility}"/>
                        </StackPanel>
                    </Border>

            <!-- Main sales area -->
            <Grid Grid.Row="1" Margin="16" Visibility="{Binding SaleScreenVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>

                <Grid Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldTextBox}"
                                 Tag="Buscar produto, SKU ou código de barras">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchOrBarcodeCommand}"/>
                                <KeyBinding Key="Enter" Command="{Binding SearchOrBarcodeCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="Buscar" Style="{StaticResource TouchButton}" Width="120" Command="{Binding SearchOrBarcodeCommand}"/>
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Categories}" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Style="{StaticResource GhostTouchButton}"
                                        Padding="18,12"
                                        Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Id}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource TouchButton}" Margin="6" MinHeight="120"
                                            Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                                            <TextBlock Text="{Binding SalePrice, StringFormat=C}" FontFamily="{StaticResource FontDisplay}"
                                                       FontSize="22" Foreground="{StaticResource BrushAccent}" TextAlignment="Center" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Cart -->
                <Border Grid.Column="1" Background="{StaticResource BrushBgPanel}" CornerRadius="20" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Carrinho" Style="{StaticResource TitleText}" FontSize="24" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding CartCountLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Cart}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushBgElevated}" CornerRadius="14" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ProductName}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding UnitPriceLabel}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding SubtotalLabel}" Foreground="{StaticResource BrushAccent}" FontFamily="{StaticResource FontDisplay}" FontSize="18" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="−" Width="48" Height="48" Style="{StaticResource TouchButton}" Margin="2"
                                                            Command="{Binding DataContext.DecreaseItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Grid Width="76" Margin="2,0" VerticalAlignment="Center">
                                                        <Border Background="Transparent" CornerRadius="10" Cursor="Hand" ToolTip="Informar quantidade"
                                                                Visibility="{Binding IsEditingQuantity, Converter={StaticResource InverseBoolToVis}}">
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick"
                                                                              Command="{Binding DataContext.BeginEditQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              CommandParameter="{Binding}"/>
                                                            </Border.InputBindings>
                                                            <TextBlock Text="{Binding QuantityLabel}" TextAlignment="Center" VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center" Margin="0,12"
                                                                       Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="Bold"/>
                                                        </Border>
                                                        <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Visibility="{Binding IsEditingQuantity, Converter={StaticResource BoolToVis}}"
                                                                 Style="{StaticResource FieldTextBox}"
                                                                 Height="48" Padding="6,8" FontSize="18" FontWeight="Bold" TextAlignment="Center"
                                                                 behaviors:QuantityEditAssist.CommitCommand="{Binding DataContext.CommitQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 behaviors:QuantityEditAssist.CancelCommand="{Binding DataContext.CancelQuantityEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </Grid>
                                                    <Button Content="+" Width="48" Height="48" Style="{StaticResource TouchButton}" Margin="2"
                                                            Command="{Binding DataContext.IncreaseItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="2" Background="{StaticResource BrushBgElevated}" CornerRadius="16" Padding="16" Margin="0,12,0,12">
                            <DockPanel>
                                <TextBlock Text="TOTAL" Foreground="{StaticResource BrushTextMuted}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CartTotalLabel}" FontFamily="{StaticResource FontDisplay}" FontSize="36" FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Limpar" Style="{StaticResource GhostTouchButton}" Height="64" Command="{Binding ClearCartCommand}"/>
                            <Button Grid.Column="1" Content="FINALIZAR VENDA" Style="{StaticResource PrimaryTouchButton}" Height="64" Command="{Binding StartPaymentCommand}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Catalog management -->
            <Grid Grid.Row="1" Margin="16" Visibility="{Binding DataContext.CatalogScreenVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" DataContext="{Binding Catalog}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="Produtos" Style="{StaticResource TouchButton}" Command="{Binding ShowProductsTabCommand}" Padding="20,12"/>
                        <Button Content="Categorias" Style="{StaticResource TouchButton}" Command="{Binding ShowCategoriesTabCommand}" Padding="20,12"/>
                        <Button Content="Atualizar" Style="{StaticResource GhostTouchButton}" Command="{Binding RefreshCommand}" Padding="20,12"/>
                    </StackPanel>
                    <TextBlock Text="{Binding EditorMessage}" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </DockPanel>

                <!-- Products tab -->
                <Grid Grid.Row="1" Visibility="{Binding ProductsTabVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource BrushBgPanel}" CornerRadius="20" Padding="16" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ProductSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource FieldComboBox}"
                                          ItemsSource="{Binding FilterCategoryOptions}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding FilterCategoryId}"
                                          Margin="0,0,8,0"/>
                                <CheckBox Grid.Column="2" Content="Inativos" Style="{StaticResource FieldCheckBox}"
                                          IsChecked="{Binding IncludeInactive}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Content="Filtrar" Style="{StaticResource TouchButton}" Width="110" Command="{Binding SearchProductsCommand}"/>
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      Style="{StaticResource CatalogDataGrid}"
                                      ItemsSource="{Binding ManagedProducts}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="*"/>
                                    <DataGridTextColumn Header="Categoria" Binding="{Binding CategoryName}" Width="*"/>
                                    <DataGridTextColumn Header="Preço" Binding="{Binding SalePrice, StringFormat=C}" Width="90"/>
                                    <DataGridTextColumn Header="Estoque" Binding="{Binding StockQuantity, StringFormat=0.###}" Width="80"/>
                                    <DataGridTextColumn Header="Ativo" Binding="{Binding IsActive}" Width="70"/>
                                    <DataGridTemplateColumn Header="" Width="210">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Editar" Style="{StaticResource GhostTouchButton}" Padding="12,8" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Desativar" Style="{StaticResource TouchButton}" Padding="12,8"
                                                            Command="{Binding DataContext.DeactivateProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource BrushBgPanel}" CornerRadius="20" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding ProductEditorTitle}" Style="{StaticResource TitleText}" FontSize="24"/>
                                <Button Content="Novo produto" Style="{StaticResource GhostTouchButton}" Margin="0,12,0,16" HorizontalAlignment="Left"
                                        Command="{Binding NewProductCommand}"/>

                                <TextBlock Text="Nome" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="SKU" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding ProductSku, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Cód. barras" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding ProductBarcode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Categorias" Style="{StaticResource MutedText}" Margin="0,12,0,6"/>
                                <Border BorderBrush="{StaticResource BrushStroke}" BorderThickness="1" CornerRadius="12" Padding="12,4,12,12" MaxHeight="180">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ProductCategoryOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}"
                                                              IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                              Style="{StaticResource FieldCheckBox}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="Preço venda" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding ProductSalePrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Style="{StaticResource FieldTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Custo" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding ProductCostPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2, TargetNullValue=''}" Style="{StaticResource FieldTextBox}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="Estoque" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding ProductStock, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" Style="{StaticResource FieldTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Unidade" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding ProductUnit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>
                                    </StackPanel>
                                </Grid>

                                <CheckBox Content="Produto ativo" Style="{StaticResource FieldCheckBox}" IsChecked="{Binding ProductIsActive}"/>

                                <Button Content="SALVAR PRODUTO" Style="{StaticResource PrimaryTouchButton}" Height="56" Margin="0,20,0,0"
                                        Command="{Binding SaveProductCommand}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Categories tab -->
                <Grid Grid.Row="1" Visibility="{Binding CategoriesTabVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource BrushBgPanel}" CornerRadius="20" Padding="16" Margin="0,0,12,0">
                        <DataGrid Style="{StaticResource CatalogDataGrid}" ItemsSource="{Binding ManagedCategories}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="2*"/>
                                <DataGridTextColumn Header="Ordem" Binding="{Binding SortOrder}" Width="80"/>
                                <DataGridTextColumn Header="Ativo" Binding="{Binding IsActive}" Width="70"/>
                                <DataGridTemplateColumn Header="" Width="210">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Editar" Style="{StaticResource GhostTouchButton}" Padding="12,8" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.EditCategoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Desativar" Style="{StaticResource TouchButton}" Padding="12,8"
                                                        Command="{Binding DataContext.DeactivateCategoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource BrushBgPanel}" CornerRadius="20" Padding="20">
                        <StackPanel>
                            <TextBlock Text="{Binding CategoryEditorTitle}" Style="{StaticResource TitleText}" FontSize="24"/>
                            <Button Content="Nova categoria" Style="{StaticResource GhostTouchButton}" Margin="0,12,0,16" HorizontalAlignment="Left"
                                    Command="{Binding NewCategoryCommand}"/>

                            <TextBlock Text="Nome" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>

                            <TextBlock Text="Descrição" Style="{StaticResource MutedText}" Margin="0,12,0,6"/>
                            <TextBox Text="{Binding CategoryDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"
                                     Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>

                            <TextBlock Text="Ordem" Style="{StaticResource MutedText}" Margin="0,12,0,6"/>
                            <TextBox Text="{Binding CategorySortOrder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>

                            <CheckBox Content="Categoria ativa" Style="{StaticResource FieldCheckBox}" IsChecked="{Binding CategoryIsActive}"/>

                            <Button Content="SALVAR CATEGORIA" Style="{StaticResource PrimaryTouchButton}" Height="56" Margin="0,20,0,0"
                                    Command="{Binding SaveCategoryCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Users management -->
            <Grid Grid.Row="1" Margin="16"  DataContext="{Binding Users}" Visibility="{Binding DataContext.UsersScreenVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="0.9*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource BrushBgPanel}" CornerRadius="20" Padding="16" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Usuários" Style="{StaticResource TitleText}" FontSize="24"/>
                            <Button Content="Atualizar" Style="{StaticResource GhostTouchButton}" Padding="14,8" HorizontalAlignment="Right"
                                    Command="{Binding RefreshCommand}"/>
                        </DockPanel>
                        <DataGrid Grid.Row="1" Style="{StaticResource CatalogDataGrid}" ItemsSource="{Binding Users}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Login" Binding="{Binding Username}" Width="*"/>
                                <DataGridTextColumn Header="Perfil" Binding="{Binding RoleLabel}" Width="*"/>
                                <DataGridTextColumn Header="Ativo" Binding="{Binding IsActive}" Width="70"/>
                                <DataGridTemplateColumn Header="" Width="210">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Editar" Style="{StaticResource GhostTouchButton}" Padding="12,8" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Desativar" Style="{StaticResource TouchButton}" Padding="12,8"
                                                        Command="{Binding DataContext.DeactivateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource BrushBgPanel}" CornerRadius="20" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource TitleText}" FontSize="24"/>
                        <Button Content="Novo usuário" Style="{StaticResource GhostTouchButton}" Margin="0,12,0,16" HorizontalAlignment="Left"
                                Command="{Binding NewCommand}"/>

                        <TextBlock Text="Nome" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>

                        <TextBlock Text="Login" Style="{StaticResource MutedText}" Margin="0,12,0,6"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"
                                 IsEnabled="{Binding UsernameEnabled}"/>

                        <TextBlock Text="PIN" Style="{StaticResource MutedText}" Margin="0,12,0,6"/>
                        <TextBox Text="{Binding Pin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>

                        <TextBlock Text="Perfil" Style="{StaticResource MutedText}" Margin="0,12,0,6"/>
                        <ComboBox Style="{StaticResource FieldComboBox}"
                                  ItemsSource="{Binding RoleOptions}"
                                  SelectedItem="{Binding Role}"/>

                        <CheckBox Content="Usuário ativo" Style="{StaticResource FieldCheckBox}" IsChecked="{Binding IsActive}"/>
                        <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        <Button Content="SALVAR USUÁRIO" Style="{StaticResource PrimaryTouchButton}" Height="56" Margin="0,16,0,0"
                                Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Sales history -->
            <Grid Grid.Row="1" Margin="16" DataContext="{Binding History}" Visibility="{Binding DataContext.HistoryScreenVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="Histórico de vendas" Style="{StaticResource TitleText}" FontSize="26" DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </DockPanel>

                <Border Grid.Row="1" Background="{StaticResource BrushBgPanel}" CornerRadius="16" Padding="14" Margin="0,0,0,12">
                    <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="168"/>
                                <ColumnDefinition Width="168"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="48"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="De" Style="{StaticResource MutedText}" Margin="0,0,12,6" VerticalAlignment="Bottom"/>
                            <DatePicker Grid.Row="1" Margin="0,0,12,0" Style="{StaticResource FieldDatePicker}"
                                        SelectedDate="{Binding FromDate}" VerticalAlignment="Stretch"/>

                            <TextBlock Grid.Column="1" Text="Até" Style="{StaticResource MutedText}" Margin="0,0,12,6" VerticalAlignment="Bottom"/>
                            <DatePicker Grid.Row="1" Grid.Column="1" Margin="0,0,12,0" Style="{StaticResource FieldDatePicker}"
                                        SelectedDate="{Binding ToDate}" VerticalAlignment="Stretch"/>

                            <TextBlock Grid.Column="2" Text="Operador" Style="{StaticResource MutedText}" Margin="0,0,12,6" VerticalAlignment="Bottom"/>
                            <ComboBox Grid.Row="1" Grid.Column="2" Margin="0,0,12,0" Style="{StaticResource FieldComboBox}"
                                      VerticalAlignment="Stretch"
                                      ItemsSource="{Binding Operators}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding OperatorId}"/>

                            <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource MutedText}" Margin="0,0,12,6" VerticalAlignment="Bottom"/>
                            <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,0,12,0" Style="{StaticResource FieldComboBox}"
                                      VerticalAlignment="Stretch"
                                      ItemsSource="{Binding StatusOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedStatus}"/>

                            <TextBlock Grid.Column="4" Text="Pagamento" Style="{StaticResource MutedText}" Margin="0,0,12,6" VerticalAlignment="Bottom"/>
                            <ComboBox Grid.Row="1" Grid.Column="4" Margin="0,0,12,0" Style="{StaticResource FieldComboBox}"
                                      VerticalAlignment="Stretch"
                                      ItemsSource="{Binding PaymentOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedPayment}"/>

                            <TextBlock Grid.Column="5" Text="Ticket" Style="{StaticResource MutedText}" Margin="0,0,0,6" VerticalAlignment="Bottom"/>
                            <TextBox Grid.Row="1" Grid.Column="5" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                     Padding="14,0" Height="48"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldTextBox}"
                                     Tag="Número do ticket"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*"/>
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <UniformGrid Columns="5" Margin="0,0,0,12">
                            <Border Background="{StaticResource BrushBgPanel}" CornerRadius="16" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Vendas" Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding SalesCountLabel}" FontFamily="{StaticResource FontDisplay}" FontSize="28" Foreground="{StaticResource BrushTextPrimary}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BrushBgPanel}" CornerRadius="16" Padding="16" Margin="8,0">
                                <StackPanel>
                                    <TextBlock Text="Concluídas" Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding CompletedCountLabel}" FontFamily="{StaticResource FontDisplay}" FontSize="28" Foreground="{StaticResource BrushSuccess}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BrushBgPanel}" CornerRadius="16" Padding="16" Margin="8,0">
                                <StackPanel>
                                    <TextBlock Text="Canceladas" Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding CancelledCountLabel}" FontFamily="{StaticResource FontDisplay}" FontSize="28" Foreground="{StaticResource BrushWarning}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BrushBgPanel}" CornerRadius="16" Padding="16" Margin="8,0">
                                <StackPanel>
                                    <TextBlock Text="Total" Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding CompletedTotalLabel}" FontFamily="{StaticResource FontDisplay}" FontSize="28" Foreground="{StaticResource BrushAccent}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BrushBgPanel}" CornerRadius="16" Padding="16" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Ticket médio" Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding AverageTicketLabel}" FontFamily="{StaticResource FontDisplay}" FontSize="28" Foreground="{StaticResource BrushTextPrimary}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Hoje" Style="{StaticResource GhostTouchButton}" Padding="16,10" Command="{Binding TodayCommand}"/>
                            <Button Content="7 dias" Style="{StaticResource GhostTouchButton}" Padding="16,10" Command="{Binding Last7DaysCommand}"/>
                            <Button Content="Resumo do dia" Style="{StaticResource GhostTouchButton}" Padding="16,10" Command="{Binding LoadDayReportCommand}"/>
                            <Button Content="Filtrar" Style="{StaticResource PrimaryTouchButton}" Padding="20,10" Command="{Binding SearchCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*"/>
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource BrushBgPanel}" CornerRadius="20" Padding="12" Margin="0,0,12,0">
                        <DataGrid Style="{StaticResource CatalogDataGrid}"
                                  ItemsSource="{Binding Sales}"
                                  SelectedItem="{Binding SelectedSale}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ticket" Binding="{Binding TicketNumber}" Width="150"/>
                                <DataGridTextColumn Header="Data" Binding="{Binding SoldAt, StringFormat={}{0:dd/MM HH:mm}}" Width="110"/>
                                <DataGridTextColumn Header="Operador" Binding="{Binding OperatorName}" Width="*"/>
                                <DataGridTextColumn Header="Terminal" Binding="{Binding TerminalCode}" Width="90"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="100"/>
                                <DataGridTextColumn Header="Pagamento" Binding="{Binding PaymentSummary}" Width="1.4*"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="100"/>
                                <DataGridTemplateColumn Header="" Width="280">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Ver" Style="{StaticResource GhostTouchButton}" Padding="12,8" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Ticket" Style="{StaticResource TouchButton}" Padding="12,8" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.ReprintCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Cancelar" Style="{StaticResource GhostTouchButton}" Padding="12,8"
                                                        Command="{Binding DataContext.BeginCancelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource BrushBgPanel}" CornerRadius="20" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Detalhe" Style="{StaticResource TitleText}" FontSize="22"/>
                            <TextBox Grid.Row="1"
                                     Text="{Binding DetailText}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{StaticResource BrushTextPrimary}"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     Margin="0,12,0,12"
                                     Visibility="{Binding DetailVisibility}"/>
                            <TextBlock Grid.Row="1" Text="Selecione uma venda na lista."
                                       Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}"/>

                            <StackPanel Grid.Row="2">
                                <Button Content="Ver ticket" Style="{StaticResource PrimaryTouchButton}" Height="52" Margin="0,0,0,8"
                                        Command="{Binding ViewDetailsCommand}" CommandParameter="{Binding SelectedSale}"/>
                                <Button Content="Reimprimir" Style="{StaticResource GhostTouchButton}" Height="52" Margin="0,0,0,8"
                                        Command="{Binding ReprintCommand}" CommandParameter="{Binding SelectedSale}"/>
                                <Button Content="Cancelar venda" Style="{StaticResource TouchButton}" Height="52"
                                        Background="#FF8B3A3A"
                                        Command="{Binding BeginCancelCommand}" CommandParameter="{Binding SelectedSale}"
                                        Visibility="{Binding CancelButtonVisibility}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Cancel sale overlay (inside history screen) -->
                <Border Grid.RowSpan="3" Background="#CC0F1419" Visibility="{Binding ShowCancelPanel, Converter={StaticResource BoolToVis}}" Panel.ZIndex="20">
                    <Border Background="{StaticResource BrushBgPanel}" CornerRadius="24" Padding="28" Width="520"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Cancelar venda" Style="{StaticResource TitleText}" FontSize="26"/>
                            <TextBlock Text="A venda permanece no histórico. Estoque e pagamentos serão revertidos."
                                       Style="{StaticResource MutedText}" Margin="0,8,0,16" TextWrapping="Wrap"/>

                            <TextBlock Text="Motivo" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding CancelReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"
                                     Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>

                            <StackPanel Visibility="{Binding AuthorizerVisibility}" Margin="0,14,0,0">
                                <TextBlock Text="Autorização (gerente/admin)" Foreground="{StaticResource BrushWarning}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Text="Usuário" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding AuthorizerUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>
                                <TextBlock Text="PIN" Style="{StaticResource MutedText}" Margin="0,12,0,6"/>
                                <TextBox Text="{Binding AuthorizerPin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"
                                         FontFamily="{StaticResource FontDisplay}" FontSize="22"/>
                            </StackPanel>

                            <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="0,14,0,0" TextWrapping="Wrap"/>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="Voltar" Style="{StaticResource GhostTouchButton}" Height="56" Command="{Binding DismissCancelCommand}"/>
                                <Button Grid.Column="1" Content="Confirmar cancelamento" Style="{StaticResource PrimaryTouchButton}" Height="56"
                                        Background="#FF8B3A3A" Command="{Binding ConfirmCancelCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="16" DataContext="{Binding CashSession}" Visibility="{Binding DataContext.CashSessionScreenVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Movimento do caixa" Style="{StaticResource TitleText}" FontSize="28" Margin="0,0,0,12"/>

                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <Border Background="{StaticResource BrushBgPanel}" CornerRadius="16" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="48"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="De" Style="{StaticResource MutedText}" Margin="0,0,12,6" VerticalAlignment="Bottom"/>
                            <DatePicker Grid.Row="1" Margin="0,0,12,0" Style="{StaticResource FieldDatePicker}"
                                        SelectedDate="{Binding FromDate}" VerticalAlignment="Stretch"/>

                            <TextBlock Grid.Column="1" Text="Até" Style="{StaticResource MutedText}" Margin="0,0,12,6" VerticalAlignment="Bottom"/>
                            <DatePicker Grid.Row="1" Grid.Column="1" Margin="0,0,12,0" Style="{StaticResource FieldDatePicker}"
                                        SelectedDate="{Binding ToDate}" VerticalAlignment="Stretch"/>

                            <Button Grid.Row="1" Grid.Column="2" Content="Mês atual" Style="{StaticResource GhostTouchButton}"
                                    Height="48" Margin="0,0,8,0" Padding="16,0" VerticalAlignment="Center"
                                    Command="{Binding CurrentMonthCommand}"/>
                            <Button Grid.Row="1" Grid.Column="3" Content="Caixa aberto" Style="{StaticResource GhostTouchButton}"
                                    Height="48" Margin="0" Padding="16,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Visibility="{Binding OpenSessionVisibility}"
                                    Command="{Binding GoToOpenSessionCommand}"/>
                        </Grid>
                    </Border>

                    <ComboBox Style="{StaticResource SessionPickerComboBox}" Margin="0,12,0,0"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Sessions}"
                              SelectedItem="{Binding SelectedSession}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontSize="18">
