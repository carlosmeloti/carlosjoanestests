<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcaiPos.Management.Views.LoginPage"
             x:Name="LoginRoot"
             x:DataType="vm:LoginViewModel"
             xmlns:vm="clr-namespace:AcaiPos.Management.ViewModels"
             BackgroundColor="{StaticResource BgDeep}">

    <Grid>
        <Border WidthRequest="420"
                Padding="32,28"
                BackgroundColor="{StaticResource BgPanel}"
                Stroke="{StaticResource Stroke}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <VerticalStackLayout Spacing="14">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="Açaí"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Accent}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="AcaiPos Management"
                           FontSize="16"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Entre com seu usuário"
                           Style="{StaticResource MutedLabel}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Usuário" Style="{StaticResource MutedLabel}" />
                    <Entry Text="{Binding UserName}"
                           Placeholder="Usuário"
                           ReturnType="Next"
                           Completed="OnUserCompleted" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Senha" Style="{StaticResource MutedLabel}" />
                    <Entry x:Name="PasswordEntry"
                           Text="{Binding Password}"
                           Placeholder="Senha"
                           IsPassword="True"
                           ReturnType="Go"
                           ReturnCommand="{Binding EnterCommand}" />
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Warning}"
                       IsVisible="{Binding HasError}" />

                <Button Text="Entrar"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding EnterCommand}"
                        HorizontalOptions="Fill"
                        Margin="0,6,0,0" />
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
